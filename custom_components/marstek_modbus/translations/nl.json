  "issues": {
    "rs485_control_mode_reset": {
      "title": "{device}: bedrijfsmodus teruggevallen — stuurcommando's zonder effect",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Besturingsmodus herstellen",
            "description": "De batterij heeft haar bedrijfsmodus zelf teruggezet naar de opgeslagen waarde. De integratie heeft hem niet gewijzigd.\n\n**Geforceerde laad- en ontlaadcommando's hebben daardoor geen effect meer.** Het vervelende: schrijfacties worden nog steeds bevestigd en metingen blijven binnenkomen — het apparaat voert de commando's alleen niet meer uit. Gemeten op een Venus D: een lopende ontlading zakte van 605 W naar 12 W, het eigen verbruik van de omvormer.\n\nVerzenden herstelt de besturingsmodus. Zet het apparaat hem opnieuw terug, dan verschijnt deze melding weer.\n\n*Let op: registers 42000 en 43000 zijn hetzelfde byte in de firmware. De besturingsmodus en de gebruikersmodus zijn één toestand met twee gezichten — de werkmodus wijzigen beëindigt ook de besturing.*"
          }
        },
        "abort": {
          "entry_not_loaded": "De integratie is momenteel niet geladen. Probeer het later opnieuw.",
          "write_failed": "De batterij heeft de opdracht niet geaccepteerd. Controleer de verbinding en probeer het opnieuw."
        }
      }
    }
  }
